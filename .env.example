# Copy this file to .env for local development. Never commit your real .env.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-private-local-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Leave empty to use the local db.sqlite3 database.
# For a local Neon connection, paste its connection string here.
DATABASE_URL=

# Optional locally. Required for media uploads in the deployed staff panel.
# Get this value from your Cloudinary dashboard; keep it private.
CLOUDINARY_URL=

# Optional: configure these with your email provider to send password resets.
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=true
